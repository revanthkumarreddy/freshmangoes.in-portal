---
import AdminLayout from '~/layouts/AdminLayout.astro';
---
<AdminLayout title="Admin Control Center Login">
  <div class="admin-login-wrapper">
    <div class="admin-login-card">
      <div class="admin-login-header">
        <h1 class="admin-login-title">Control Center</h1>
        <p class="admin-login-subtitle">Authorized staff only · FreshMangoes</p>
      </div>

      <form id="admin-login-form" class="admin-login-form" autocomplete="off">
        <div class="form-group">
          <label for="admin-email">Admin Email</label>
          <input type="email" id="admin-email" placeholder="staff@example.com" required autocomplete="username" maxlength="120" />
        </div>

        <div class="form-group">
          <label for="admin-passcode">Passcode</label>
          <input type="password" id="admin-passcode" placeholder="••••••••" required autocomplete="current-password" maxlength="128" />
        </div>

        <button type="submit" class="admin-login-btn" id="admin-submit">
          Access Dashboard
        </button>

        <p id="admin-error" class="admin-error-msg hidden" role="alert"></p>
        <p class="admin-hint">Orders &amp; payments are managed in the Wix dashboard. This panel is an internal demo view only.</p>
      </form>
    </div>
  </div>

  <script>
    import { isAdminSessionValid, tryAdminLogin } from '~/lib/admin-auth';

    document.addEventListener('DOMContentLoaded', () => {
      const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
      const form = document.getElementById('admin-login-form');
      const errorMsg = document.getElementById('admin-error');
      const submitBtn = document.getElementById('admin-submit') as HTMLButtonElement | null;

      if (isAdminSessionValid()) {
        window.location.replace(`${BASE}/admin`);
        return;
      }

      // Clear legacy insecure flag
      try { localStorage.removeItem('fm:admin_auth'); } catch {}

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        const email = (document.getElementById('admin-email') as HTMLInputElement)?.value;
        const passcode = (document.getElementById('admin-passcode') as HTMLInputElement)?.value;

        const result = await tryAdminLogin(email, passcode);
        if (result.ok) {
          window.location.replace(`${BASE}/admin`);
          return;
        }
        if (errorMsg) {
          errorMsg.textContent = result.error || 'Access denied.';
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) submitBtn.disabled = false;
      });
    });
  </script>

  <style>
    .admin-login-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #09090b;
      padding: 1.25rem;
    }
    .admin-login-card {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 12px;
      padding: 2.5rem 2rem;
      width: 100%;
      max-width: 400px;
    }
    .admin-login-header { text-align: center; margin-bottom: 2rem; }
    .admin-login-title {
      font-size: 1.5rem; font-weight: 600; color: #fafafa; margin: 0 0 0.25rem;
    }
    .admin-login-subtitle { font-size: 0.85rem; color: #a1a1aa; margin: 0; }
    .admin-login-form { display: flex; flex-direction: column; gap: 1.25rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group label {
      font-size: 0.75rem; font-weight: 500; color: #d4d4d8;
      text-transform: uppercase; letter-spacing: 0.05em;
    }
    .form-group input {
      background: #09090b; border: 1px solid #27272a; border-radius: 6px;
      padding: 0.75rem 1rem; color: #fafafa; font-size: 16px; outline: none;
    }
    .form-group input:focus { border-color: #eab308; }
    .admin-login-btn {
      background: #fafafa; color: #09090b; border: none; border-radius: 6px;
      padding: 0.85rem; font-weight: 600; font-size: 0.9rem; cursor: pointer;
    }
    .admin-login-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .admin-error-msg {
      color: #ef4444; font-size: 0.8rem; text-align: center; margin: 0;
      padding: 0.75rem; background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px;
    }
    .admin-hint { font-size: 0.72rem; color: #71717a; text-align: center; line-height: 1.45; margin: 0; }
    .hidden { display: none !important; }
  </style>
</AdminLayout>
