---
import Base from '~/layouts/Base.astro';
---
<Base title="Contact us — FreshMangoes" description="Get in touch with the FreshMangoes team — questions, bulk orders, partnerships welcome.">
  <section class="container-x py-16 max-w-2xl">
    <p class="eyebrow mb-3">Hello</p>
    <h1 class="display text-5xl md:text-6xl">Say hi.</h1>
    <p class="mt-4 text-lg text-[color:var(--color-ink-soft)]">
      Questions about a box, a bulk order, or just to say a mango made you smile — we'd love to hear it.
    </p>

    <div class="mt-12 grid gap-4">
      <a href="mailto:freshmangoes.in@gmail.com" class="block py-5 border-b border-black/10 hover:border-[color:var(--color-leaf-500)] transition-colors">
        <p class="display text-2xl">Email us</p>
        <p class="text-sm text-[color:var(--color-ink-soft)] mt-1">freshmangoes.in@gmail.com · We reply within one working day.</p>
      </a>
      <a href="https://wa.me/919844763416" class="block py-5 border-b border-black/10 hover:border-[color:var(--color-leaf-500)] transition-colors">
        <p class="display text-2xl">WhatsApp / Call</p>
        <p class="text-sm text-[color:var(--color-ink-soft)] mt-1">+91 9844763416 · Tap to chat or call our helpline.</p>
      </a>
      <div class="py-5">
        <p class="display text-2xl">Our orchard</p>
        <p class="text-sm text-[color:var(--color-ink-soft)] mt-1">Srinivasapur, Kolar district - 563138, Karnataka — India</p>
        <p class="text-xs text-[color:var(--color-ink-soft)] mt-1 opacity-80">Visits welcome by appointment during harvest season.</p>
      </div>
    </div>
  </section>
</Base>
