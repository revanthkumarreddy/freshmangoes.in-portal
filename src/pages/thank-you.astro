---
import Base from '~/layouts/Base.astro';
import { url } from '~/lib/url';
---
<Base title="Thank you — FreshMangoes" noindex>
  <section class="container-x py-24 text-center max-w-2xl mx-auto">
    <p class="eyebrow mb-4">Order received</p>
    <h1 class="display text-5xl md:text-6xl">Thank you.</h1>
    <p class="mt-5 text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
      Your mangoes are on their way to being picked. We'll send a confirmation email shortly with
      tracking once your box leaves the orchard.
    </p>
    <p id="order-ref" class="mt-6 text-sm text-[color:var(--color-ink-soft)]"></p>
    <div class="mt-10 flex justify-center gap-3 flex-wrap">
      <a href={url('/')} class="btn btn-ghost">Back to home</a>
      <a href={url('/shop')} class="btn btn-primary">Shop more</a>
    </div>
  </section>

  <script>
    const url = new URL(window.location.href);
    const id = url.searchParams.get('orderId') || url.searchParams.get('order_id');
    if (id) {
      const el = document.getElementById('order-ref');
      if (el) el.textContent = `Order reference: ${id}`;
    }
    try { window.localStorage.removeItem('fm:checkout_done'); } catch {}
  </script>
</Base>
