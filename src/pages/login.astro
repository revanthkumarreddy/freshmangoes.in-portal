---
import Base from '~/layouts/Base.astro';
import { url } from '~/lib/url';
---
<Base title="Log in — FreshMangoes" noindex>
  <section class="login-page">
    <div class="login-card-centered">
      <p class="eyebrow mb-3 text-center">Secure member access</p>
      <h1 class="display text-3xl text-center mb-2">Welcome back</h1>
      <p class="text-sm text-center text-[color:var(--color-ink-soft)] mb-8 leading-relaxed">
        Sign in with Google via Wix to checkout securely. Your cart and orders stay protected on our store backend.
      </p>

      <button id="wix-login-btn" class="btn btn-primary w-full gap-2" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      <p id="login-error" class="form-error hidden mt-4" role="alert"></p>

      <div id="state-success" class="hidden text-center mt-6">
        <h2 class="display text-2xl text-[color:var(--color-leaf-600)] mb-2">You're in</h2>
        <p class="text-sm text-[color:var(--color-ink-soft)]">Redirecting…</p>
      </div>

      <p class="login-hint mt-8">
        We never store passwords in the browser. Checkout requires a verified Wix member session.
      </p>

      <div class="login-footer">
        <a href={url('/')} class="login-back-link">← Back to store</a>
      </div>
    </div>
  </section>

  <script>
    import { wixClient, isLoggedIn } from '~/lib/wix-client';

    document.addEventListener('DOMContentLoaded', () => {
      const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
      const wixLoginBtn = document.getElementById('wix-login-btn') as HTMLButtonElement | null;
      const successEl = document.getElementById('state-success');
      const errorEl = document.getElementById('login-error');

      // Clear legacy insecure local auth artifacts
      try {
        localStorage.removeItem('fm:users');
        localStorage.removeItem('fm:user');
      } catch {}

      if (isLoggedIn()) {
        showSuccess();
        return;
      }

      wixLoginBtn?.addEventListener('click', async () => {
        try {
          wixLoginBtn.setAttribute('disabled', 'true');
          wixLoginBtn.textContent = 'Redirecting…';

          const REDIRECT_URI =
            (import.meta.env.PUBLIC_WIX_REDIRECT_URI as string) ||
            `${window.location.origin}${BASE}/login-callback`;

          const returnUrl = new URL(`${BASE}/account`, window.location.origin).href;
          const oauthData = wixClient.auth.generateOAuthData(REDIRECT_URI, returnUrl);
          sessionStorage.setItem('wix:oauthData', JSON.stringify(oauthData));

          const { authUrl } = await wixClient.auth.getAuthUrl(oauthData);
          if (!authUrl || !/^https:\/\//i.test(authUrl)) {
            throw new Error('Invalid auth URL');
          }
          window.location.href = authUrl;
        } catch (err) {
          console.error('[FreshMangoes] Wix OAuth error');
          wixLoginBtn.removeAttribute('disabled');
          wixLoginBtn.innerHTML = `Continue with Google`;
          if (errorEl) {
            errorEl.textContent = 'Could not start secure login. Check Wix OAuth redirect settings, then try again.';
            errorEl.classList.remove('hidden');
          }
        }
      });

      function showSuccess() {
        wixLoginBtn?.classList.add('hidden');
        successEl?.classList.remove('hidden');
        const autoCheckout = new URLSearchParams(window.location.search).get('checkout') === '1';
        setTimeout(() => {
          window.location.replace(autoCheckout ? `${BASE}/cart?autoCheckout=1` : `${BASE}/account`);
        }, 800);
      }
    });
  </script>

  <style>
    .login-page {
      min-height: calc(100dvh - 68px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.25rem;
      padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    }
    .login-card-centered {
      background: white;
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 1.25rem;
      padding: 2rem 1.5rem;
      max-width: 420px;
      width: 100%;
    }
    .login-hint {
      font-size: 0.75rem;
      color: var(--color-ink-soft);
      text-align: center;
      line-height: 1.5;
    }
    .login-footer { text-align: center; margin-top: 1.25rem; }
    .login-back-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-leaf-600);
    }
    .form-error {
      font-size: 0.8rem;
      color: #b91c1c;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 0.75rem;
      padding: 0.75rem 1rem;
      text-align: center;
    }
    .hidden { display: none !important; }
  </style>
</Base>
