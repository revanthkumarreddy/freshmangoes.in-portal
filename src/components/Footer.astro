---
import { url } from '~/lib/url';
import Logo from '~/components/Logo.astro';
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-[color:var(--color-ink)] text-[color:var(--color-cream)]">
  <div class="container-x py-16 grid gap-12 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="mb-4">
        <Logo tone="cream" />
      </div>
      <p class="text-sm opacity-80 max-w-sm leading-relaxed">
        Hand-picked, natural ripening &amp; carbide-free mangoes from our family orchard in Srinivasapur, Karnataka.
        Farming heritage since 1985 — in every box.
      </p>
      <p class="text-xs opacity-60 mt-6">Free shipping across India on orders over ₹599.</p>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider opacity-70 mb-4">Shop</h4>
      <ul class="space-y-2 text-sm">
        <li><a href={url('/shop')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">All mangoes</a></li>
        <li><a href={url('/about')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">Our farm story</a></li>
        <li><a href={url('/faq')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">FAQ &amp; shipping</a></li>
        <li><a href={url('/contact')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">Get in touch</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider opacity-70 mb-4">Account</h4>
      <ul class="space-y-2 text-sm">
        <li><a href={url('/login')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">Log in</a></li>
        <li><a href={url('/account')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">My Account</a></li>
        <li><a href={url('/cart')} class="opacity-90 hover:opacity-100 hover:text-[color:var(--color-saffron-300)]">Cart</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider opacity-70 mb-4">Reach us</h4>
      <ul class="space-y-2 text-sm opacity-90">
        <li>Srinivasapur, Kolar district - 563138</li>
        <li>Karnataka, India</li>
        <li class="mt-2"><a href="mailto:freshmangoes.in@gmail.com" class="hover:text-[color:var(--color-saffron-300)] font-medium">freshmangoes.in@gmail.com</a></li>
        <li><a href="tel:+919844763416" class="hover:text-[color:var(--color-saffron-300)] font-medium">Helpline: +91 9844763416</a></li>
        <li><a href="https://wa.me/919844763416" class="hover:text-[color:var(--color-saffron-300)] font-medium">WhatsApp us</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x py-6 text-xs opacity-70 flex flex-col md:flex-row gap-2 md:justify-between">
      <span>© {year} FreshMangoes. All rights reserved.</span>
      <span>Grown in Srinivasapur · Delivered across India</span>
    </div>
  </div>
</footer>
