---
import { url } from '~/lib/url';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

function active(segment: 'home' | 'shop' | 'cart' | 'account') {
  if (segment === 'home') return path === '/' || path === base || path === '';
  return path.includes(`/${segment}`);
}
---
<nav
  class="md:hidden fixed inset-x-0 bottom-0 z-40 border-t border-black/8 bg-[color:var(--color-paper)]/95 backdrop-blur-md"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  aria-label="Mobile primary"
>
  <div class="grid grid-cols-4 h-[4.25rem]">
    <a href={url('/')} class:list={['mobile-tab', active('home') && 'mobile-tab-active']} aria-current={active('home') ? 'page' : undefined}>
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/></svg>
      <span>Home</span>
    </a>
    <a href={url('/shop')} class:list={['mobile-tab', active('shop') && 'mobile-tab-active']} aria-current={active('shop') ? 'page' : undefined}>
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16l-1.5 12h-13z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
      <span>Shop</span>
    </a>
    <a href={url('/cart')} class:list={['mobile-tab', active('cart') && 'mobile-tab-active']} aria-current={active('cart') ? 'page' : undefined}>
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      <span>Cart</span>
    </a>
    <a href={url('/account')} class:list={['mobile-tab', active('account') && 'mobile-tab-active']} aria-current={active('account') ? 'page' : undefined}>
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/></svg>
      <span>Account</span>
    </a>
  </div>
</nav>

<style>
  .mobile-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-tab-active { color: var(--color-leaf-600); }
</style>
